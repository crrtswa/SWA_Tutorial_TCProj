<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="UM_Tutorial" Id="{98a93146-8600-4fd2-a2c5-604a09700b9c}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FINAL UM_Tutorial EXTENDS PML_UnitMachine IMPLEMENTS I_UmTutorial

VAR
	// Tags trailing properties


	// PB Instance Declaration


	// Sequence Instance Declaration


	// Module/Device Instance Declaration
	
	DiResetPb			: DEV_DigitalIn	:= (Description := 'Reset PB'); //Machine Reset Pushbutton Attach to the Unit Machine for uses beyond ESTOP reset
	DiMomentaryPb		: DEV_DigitalIn	:= (Description := 'Momentary PB');
	CylExample			: DEV_Cylinder := (Description := 'Example Cyl', ValveType := E_ValveType.Five2SingleNR, ViewedAsEngDiseng := FALSE, RetractIsEngaged := FALSE);
	DoSignalPl			: DEV_DigitalOut := (Description := 'Signal Pilot Light');
    cmModule			: CM_ControlModule	:= (Description	:= 'Control Module',
											UseGenericVisu	:= TRUE,
											HasParams := FALSE,
											HasStatus := FALSE);	
	//DevLists
	ModuleDevList	: ST_ControlModuleDevList := (DiMomentaryPb	:= DiMomentaryPb,
													CylExample		:= CylExample,
													DoSignalPl		:= DoSignalPl);
											
	// Other local variables
	cmd	: E_UmTutorialCmd;

END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Call Pushbutton FBs (or Update command)


// Evaluate commands to drive states, run methods of devices (ax.MoveAbs), run seq etc.
StateTransitionLogic();

// Call Sequence FBs




// Call Module/Device FBs
SUPER^(); // Basically a module. Call other modules below this.
DiResetPb();
DiMomentaryPb();
CylExample();
DoSignalPl();
cmModule(DevList := ModuleDevList);

// Reset cmd at end of FB Scan
cmd := E_UmTutorialCmd.NoCmd;]]></ST>
    </Implementation>
