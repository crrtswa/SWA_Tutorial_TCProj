<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="CM_ControlModule" Id="{6bd9f387-eeb9-4515-9779-aa7709b1122b}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FINAL CM_ControlModule EXTENDS PML_Module IMPLEMENTS I_CmControlModule
VAR_IN_OUT
    DevList : ST_ControlModuleDevList;
END_VAR
VAR
	// Tags trailing properties


	// PB Instance Declaration


	// Sequence Instance Declaration
	seqModuleSequence	: SEQ_ModuleSequence := (Description := 'Module Sequence', _enableHmiStart := TRUE, _enableSfcTipCtrl := FALSE);

	// Module/Device Instance Declaration

	// Other local variables
	cmd	: E_CmControlModuleCmd;

END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Call Pushbutton FBs (or Update command)


// Evaluate commands to drive states, run methods of devices (ax.MoveAbs), run seq etc.
StateTransitionLogic();

// Call Sequence FBs
// Call Sequence FBs
seqModuleSequence(DevList := THIS^.DevList);

// Call Module/Device FBs
SUPER^(); // Basically a module. Call other modules below this.


// Reset cmd at end of FB Scan
cmd := E_CmControlModuleCmd.NoCmd;]]></ST>
    </Implementation>
